+meshBridge = s:option(ListValue, "bridge_device", translate("MESH LAN bridge"))
+meshBridge.description = translate("Bridge that carries untagged bat0; select exactly one")
+meshBridge:value("", translate("-- Select a bridge --"))
+uci:foreach("network", "device",
+							function(device)
+								if device.type == "bridge" and device.name then
+									meshBridge:value(device.name)
