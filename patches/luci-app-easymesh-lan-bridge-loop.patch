@@ -21,0 +22,46 @@ load_easymesh_config() {
+find_mesh_bridge() {
+	local section
+
+	[ -n "$mesh_bridge" ] || return 1
+	for section in $(uci -q show network | sed -n 's/^network\.\([^=]*\)=device$/\1/p'); do
+		[ "$(uci -q get "network.$section.name")" = "$mesh_bridge" ] || continue
+		[ "$(uci -q get "network.$section.type")" = "bridge" ] || continue
+		printf '%s\n' "$section"
+		return 0
+	done
+	return 1
+}
+
+repair_legacy_lan_device() {
+	local original_lan_device=$lan_device
+
+	while [ "${lan_device% bat0}" != "$lan_device" ]; do
+		lan_device=${lan_device% bat0}
+	done
+	[ "$lan_device" = "$original_lan_device" ] || uci set "network.lan.device=$lan_device"
+
+	[ -n "$mesh_bridge" ] || mesh_bridge=$lan_device
+}
+
+remove_bat0_from_bridges() {
+	local section
+
+	for section in $(uci -q show network | sed -n 's/^network\.\([^=]*\)=device$/\1/p'); do
+		[ "$(uci -q get "network.$section.type")" = "bridge" ] || continue
+		uci -q del_list "network.$section.ports=bat0"
+	done
+}
+
+configure_mesh_bridge() {
+	local bridge
+
+	bridge=$(find_mesh_bridge) || {
+		echo "easymesh: bridge_device '$mesh_bridge' is not a bridge; refusing to attach bat0" >&2
+		return 1
+	}
+
+	remove_bat0_from_bridges
+	uci set "network.$bridge.stp=1"
+	uci add_list "network.$bridge.ports=bat0"
+}
+
